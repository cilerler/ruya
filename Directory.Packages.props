<Project>
	<PropertyGroup>
		<ManagePackageVersionsCentrally>true</ManagePackageVersionsCentrally>
		<CentralPackageFloatingVersionsEnabled>true</CentralPackageFloatingVersionsEnabled>
		<CentralPackageTransitivePinningEnabled>false</CentralPackageTransitivePinningEnabled>
	</PropertyGroup>

	<ItemGroup>
		<GlobalPackageReference Include="Microsoft.CodeAnalysis.NetAnalyzers" Version="10.0.100"
			PrivateAssets="All"
			IncludeAssets="runtime;build;native;contentfiles;analyzers;buildtransitive" />

		<GlobalPackageReference Include="SonarAnalyzer.CSharp" Version="10.15.0.120848"
			PrivateAssets="All"
			IncludeAssets="runtime;build;native;contentfiles;analyzers;buildtransitive" />

		<GlobalPackageReference Include="Microsoft.SourceLink.GitHub" Version="8.0.0"
			PrivateAssets="All" />
	</ItemGroup>

	<!-- Testing - MSTest -->
	<ItemGroup>
		<PackageVersion Include="MSTest" Version="4.0.2" />	<!-- use this instead of MSTest.TestAdapter and MSTest.TestFramework -->
		<PackageVersion Include="MSTest.TestAdapter" Version="4.0.2" />
		<PackageVersion Include="MSTest.TestFramework" Version="4.0.2" />
		<PackageVersion Include="Microsoft.NET.Test.Sdk" Version="18.0.1" />
		<PackageVersion Include="Microsoft.Testing.Extensions.CodeCoverage" Version="18.1.0" /> <!-- use this instead of coverlet.collector-->
		<PackageVersion Include="Microsoft.Testing.Extensions.Fakes" Version="18.1.1" /> <!-- use this instead of Moq when you can -->
		<PackageVersion Include="Microsoft.Testing.Extensions.TrxReport" Version="2.0.2" />
		<PackageVersion Include="Moq" Version="4.20.72" />

		<PackageVersion Include="Testcontainers" Version="4.9.0" />
		<PackageVersion Include="Testcontainers.Redis" Version="4.9.0" />
		<PackageVersion Include="Testcontainers.RabbitMQ" Version="4.9.0" />
		<PackageVersion Include="Testcontainers.MsSql" Version="4.9.0" />
	</ItemGroup>

	<!-- .NET / ASP.NET Core -->
	<ItemGroup>
		<PackageVersion Include="Microsoft.AspNetCore.Components.Web" Version="8.*" />
		<PackageVersion Include="Microsoft.AspNetCore.Components.WebAssembly.Server" Version="8.*" />
		<PackageVersion Include="Microsoft.AspNetCore.Components.WebAssembly" Version="8.*" />
		<PackageVersion Include="Microsoft.Extensions.Caching.Abstractions" Version="8.*" />
		<PackageVersion Include="Microsoft.Extensions.Caching.Hybrid" Version="10.*" />
		<PackageVersion Include="Microsoft.Extensions.Caching.StackExchangeRedis" Version="8.*" />
		<PackageVersion Include="Microsoft.Extensions.Configuration.Abstractions" Version="8.*" />
		<PackageVersion Include="Microsoft.Extensions.Configuration.Binder" Version="8.*" />
		<PackageVersion Include="Microsoft.Extensions.Configuration.EnvironmentVariables" Version="8.*" />
		<PackageVersion Include="Microsoft.Extensions.Configuration.Json" Version="8.*" />
		<PackageVersion Include="Microsoft.Extensions.Configuration" Version="8.*" />
		<PackageVersion Include="Microsoft.Extensions.DependencyInjection.Abstractions" Version="8.*" />
		<PackageVersion Include="Microsoft.Extensions.DependencyInjection" Version="8.*" />
		<PackageVersion Include="Microsoft.Extensions.Diagnostics.Abstractions" Version="8.*" />
		<PackageVersion Include="Microsoft.Extensions.Diagnostics.HealthChecks" Version="8.*" />
		<PackageVersion Include="Microsoft.Extensions.Hosting" Version="8.*" />
		<PackageVersion Include="Microsoft.Extensions.Hosting.Abstractions" Version="8.*" />
		<PackageVersion Include="Microsoft.Extensions.Hosting" Version="8.*" />
		<PackageVersion Include="Microsoft.Extensions.Http" Version="8.*" />
		<PackageVersion Include="Microsoft.Extensions.Logging.Abstractions" Version="8.*" />
		<PackageVersion Include="Microsoft.Extensions.Logging.Configuration" Version="8.*" />
		<PackageVersion Include="Microsoft.Extensions.Logging.Console" Version="8.*" />
		<PackageVersion Include="Microsoft.Extensions.Logging.Debug" Version="8.*" />
		<PackageVersion Include="Microsoft.Extensions.Logging" Version="8.*" />
		<PackageVersion Include="Microsoft.Extensions.Options.ConfigurationExtensions" Version="8.*" />
		<PackageVersion Include="Microsoft.Extensions.Options.DataAnnotations" Version="8.*" />
		<PackageVersion Include="Microsoft.Extensions.Options" Version="8.*" />
		<PackageVersion Include="System.Text.Json" Version="8.*" />
	</ItemGroup>

	<!-- Security & Authentication -->
	<ItemGroup>
		<PackageVersion Include="Microsoft.AspNetCore.Authentication.JwtBearer" Version="8.*" />
		<PackageVersion Include="System.IdentityModel.Tokens.Jwt" Version="8.14.0" />
	</ItemGroup>

	<!-- Database - SQL Server -->
	<ItemGroup>
		<PackageVersion Include="Microsoft.Data.SqlClient" Version="6.1.3" />
		<PackageVersion Include="Microsoft.EntityFrameworkCore.Design" Version="8.*" />
		<PackageVersion Include="Microsoft.EntityFrameworkCore.InMemory" Version="8.*" />
		<PackageVersion Include="Microsoft.EntityFrameworkCore.SqlServer" Version="8.*" />
		<PackageVersion Include="Microsoft.EntityFrameworkCore.Tools" Version="8.*" />
	</ItemGroup>

	<!-- DAPR -->
	<ItemGroup>
		<PackageVersion Include="Dapr.AspNetCore" Version="1.16.1" />
		<PackageVersion Include="Dapr.Client" Version="1.16.1" />
		<PackageVersion Include="Dapr.Extensions.Configuration" Version="1.16.1" />
	</ItemGroup>

	<!-- OpenTelemetry -->
	<ItemGroup>
		<PackageVersion Include="OpenTelemetry.Api" Version="1.14.0" />
		<PackageVersion Include="OpenTelemetry.Exporter.Console" Version="1.14.0" />
		<PackageVersion Include="OpenTelemetry.Exporter.InMemory" Version="1.14.0" />
		<PackageVersion Include="OpenTelemetry.Exporter.OpenTelemetryProtocol" Version="1.14.0" />
		<PackageVersion Include="OpenTelemetry.Exporter.Prometheus.AspNetCore" Version="1.14.0-beta.1" NoWarn="NU5104" />
		<PackageVersion Include="OpenTelemetry.Extensions.Hosting" Version="1.14.0" />
		<PackageVersion Include="OpenTelemetry.Instrumentation.AspNetCore" Version="1.14.0" />
		<PackageVersion Include="OpenTelemetry.Instrumentation.EntityFrameworkCore" Version="1.14.0-beta.2" NoWarn="NU5104" />
		<PackageVersion Include="OpenTelemetry.Instrumentation.GrpcNetClient" Version="1.14.0-beta.1" NoWarn="NU5104" />
		<PackageVersion Include="OpenTelemetry.Instrumentation.Http" Version="1.14.0" />
		<PackageVersion Include="OpenTelemetry.Instrumentation.Process" Version="1.14.0-beta.2" NoWarn="NU5104" />
		<PackageVersion Include="OpenTelemetry.Instrumentation.Runtime" Version="1.14.0" />
		<PackageVersion Include="OpenTelemetry.Instrumentation.SqlClient" Version="1.14.0-beta.1" NoWarn="NU5104" />
		<PackageVersion Include="OpenTelemetry.Instrumentation.StackExchangeRedis" Version="1.14.0-beta.1" NoWarn="NU5104" />
		<PackageVersion Include="OpenTelemetry" Version="1.14.0" />
	</ItemGroup>

	<!-- Common Utilities -->
	<ItemGroup>
		<PackageVersion Include="Polly" Version="8.6.5" />
		<PackageVersion Include="MimeTypesMap" Version="1.0.9" />
		<PackageVersion Include="StackExchange.Redis" Version="2.10.1" />
		<PackageVersion Include="RabbitMQ.Client" Version="7.2.0" />
		<PackageVersion Include="Cronos" Version="0.11.1" />
	</ItemGroup>

	<!-- Cloud Storage Providers -->
	<ItemGroup>
		<PackageVersion Include="Azure.Identity" Version="1.17.1" />
		<PackageVersion Include="Azure.Storage.Blobs" Version="12.26.0" />
		<PackageVersion Include="Google.Cloud.Storage.V1" Version="4.13.0" />
		<PackageVersion Include="AWSSDK.S3" Version="4.0.13" />
		<PackageVersion Include="AWSSDK.Extensions.NETCore.Setup" Version="4.0.3" />
	</ItemGroup>

	<ItemGroup>
		<PackageVersion Include="Ruya.Primitives" Version="[8.1.0,)">
			<NoWarn>NU1604;NU1011</NoWarn>
		</PackageVersion>
		<PackageVersion Include="Ruya.Diagnostics" Version="8.1.*" />
		<PackageVersion Include="Ruya.Diagnostics.Abstractions" Version="8.1.*" />
		<PackageVersion Include="Ruya.EntityFrameworkCore.SqlServer" Version="8.1.*" />
		<PackageVersion Include="Ruya.Extensions.Configuration" Version="8.1.*" />
		<PackageVersion Include="Ruya.Extensions.DependencyInjection" Version="8.1.*" />
		<PackageVersion Include="Ruya.OpenTelemetry" Version="8.1.*" />
		<PackageVersion Include="Ruya.Services.CloudStorage.Abstractions" Version="8.1.*" />
		<PackageVersion Include="Ruya.Services.CloudStorage.Amazon" Version="8.1.*" />
		<PackageVersion Include="Ruya.Services.CloudStorage.Azure" Version="8.1.*" />
		<PackageVersion Include="Ruya.Services.CloudStorage.Google" Version="8.1.*" />
		<PackageVersion Include="Ruya.Services.CloudStorage.Local" Version="8.1.*" />
		<PackageVersion Include="Ruya.Services.DistributedLock.Abstractions" Version="8.1.*" />
		<PackageVersion Include="Ruya.Services.DistributedLock.InMemory" Version="8.1.*" />
		<PackageVersion Include="Ruya.Services.DistributedLock.MsSql" Version="8.1.*" />
		<PackageVersion Include="Ruya.Services.DistributedLock.Redis" Version="8.1.*" />
		<PackageVersion Include="Ruya.Services.DistributedLock" Version="8.1.*" />
		<PackageVersion Include="Ruya.Services.MessageQueue.InMemory" Version="8.1.*" />
		<PackageVersion Include="Ruya.Services.MessageQueue.MsSql" Version="8.1.*" />
		<PackageVersion Include="Ruya.Services.MessageQueue.RabbitMq" Version="8.1.*" />
		<PackageVersion Include="Ruya.Services.MessageQueue.Redis" Version="8.1.*" />
		<PackageVersion Include="Ruya.Services.MessageQueue" Version="8.1.*" />
		<PackageVersion Include="Ruya.System.Xml.Serialization" Version="8.1.*" />
		<PackageVersion Include="Ruya.Testing.Primitives" Version="8.1.*" />
	</ItemGroup>
</Project>
