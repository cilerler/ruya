<Project Sdk="Microsoft.NET.Sdk">

	<PropertyGroup>
		<TargetFramework>net8.0</TargetFramework>

		<IsPackable>false</IsPackable>

		<IsTestProject>true</IsTestProject>
		<OutputType>Exe</OutputType>
		<EnableMSTestRunner>true</EnableMSTestRunner>

		<TestingPlatformDotnetTestSupport>true</TestingPlatformDotnetTestSupport>
		<TestingPlatformShowTestsFailure>true</TestingPlatformShowTestsFailure>

		<TestingExtensionsProfile>AllMicrosoft</TestingExtensionsProfile>
	</PropertyGroup>

	<ItemGroup>
		<PackageReference Include="Microsoft.NET.Test.Sdk" />
		<PackageReference Include="MSTest" />
		<PackageReference Include="Moq" />
	</ItemGroup>

	<ItemGroup>
    <ProjectReference Include="..\..\src\Ruya.Extensions.Hosting\Ruya.Extensions.Hosting.csproj" />
    <ProjectReference Include="..\..\src\Ruya.Testing.Primitives\Ruya.Testing.Primitives.csproj" />
  </ItemGroup>

</Project>
