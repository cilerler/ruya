<Project Sdk="Microsoft.NET.Sdk">

	<PropertyGroup>
		<TargetFramework>net8.0</TargetFramework>

		<IsPackable>false</IsPackable>

		<IsTestProject>true</IsTestProject>
		<OutputType>Exe</OutputType>
		<EnableMSTestRunner>true</EnableMSTestRunner>

		<TestingPlatformDotnetTestSupport>true</TestingPlatformDotnetTestSupport>
		<TestingPlatformShowTestsFailure>true</TestingPlatformShowTestsFailure>

		<TestingExtensionsProfile>AllMicrosoft</TestingExtensionsProfile>

		<!-- Integration tests must exercise the current core contract in every configuration. -->
		<UseLocalMessageQueueProjectReference>true</UseLocalMessageQueueProjectReference>
	</PropertyGroup>

	<ItemGroup>
		<PackageReference Include="Microsoft.NET.Test.Sdk" />
		<PackageReference Include="MSTest" />
		<PackageReference Include="Microsoft.Testing.Extensions.CodeCoverage" />
		<PackageReference Include="Microsoft.Data.SqlClient" />
		<PackageReference Include="Microsoft.Extensions.DependencyInjection" />
		<PackageReference Include="Microsoft.Extensions.Logging" />
		<PackageReference Include="Testcontainers.MsSql" />
	</ItemGroup>

	<ItemGroup>
		<ProjectReference
			Include="..\..\src\Ruya.Services.MessageQueue.MsSql\Ruya.Services.MessageQueue.MsSql.csproj"
			AdditionalProperties="UseLocalMessageQueueProjectReference=true" />
	</ItemGroup>

	<ItemGroup>
		<EmbeddedResource Include="Resources\SQL\*.sql" />
	</ItemGroup>

</Project>
