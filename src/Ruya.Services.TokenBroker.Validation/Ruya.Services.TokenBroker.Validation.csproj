<Project Sdk="Microsoft.NET.Sdk">

	<PropertyGroup>
		<TargetFramework>net8.0</TargetFramework>
	</PropertyGroup>

	<ItemGroup>
		<InternalsVisibleTo Include="Ruya.Services.TokenBroker" />
	</ItemGroup>

	<PropertyGroup>
		<Description>Lightweight JWT validation library for Token Service - validates incoming tokens without token issuance dependencies</Description>
		<PackageTags>token;service;validation;jwt;authentication</PackageTags>
		<Version>8.2</Version>
	</PropertyGroup>

	<ItemGroup>
		<FrameworkReference Include="Microsoft.AspNetCore.App" />
	</ItemGroup>

	<ItemGroup>
		<PackageReference Include="Microsoft.AspNetCore.Authentication.JwtBearer" />
	</ItemGroup>

	<ItemGroup Condition="'$(Configuration)' == 'Release' And '$(UseLocalTokenBrokerProjectReferences)' != 'true'">
		<PackageReference Include="Ruya.Services.TokenBroker.Abstractions" />
	</ItemGroup>

	<ItemGroup Condition="'$(Configuration)' == 'Debug' Or '$(UseLocalTokenBrokerProjectReferences)' == 'true'">
		<ProjectReference Include="..\Ruya.Services.TokenBroker.Abstractions\Ruya.Services.TokenBroker.Abstractions.csproj" />
	</ItemGroup>

</Project>
