<Project Sdk="Microsoft.NET.Sdk">

	<PropertyGroup>
		<TargetFramework>net8.0</TargetFramework>
	</PropertyGroup>

	<PropertyGroup>
		<Description>Redis provider implementation (Pub/Sub and Streams)</Description>
		<PackageTags>messaging;redis;pub-sub;streams;event-driven</PackageTags>
		<Version>8.2</Version>
	</PropertyGroup>

	<ItemGroup Condition="'$(Configuration)' == 'Release' And '$(UseLocalMessageQueueProjectReference)' != 'true'">
		<PackageReference Include="Ruya.Services.MessageQueue" />
	</ItemGroup>

	<ItemGroup Condition="'$(Configuration)' == 'Debug' Or '$(UseLocalMessageQueueProjectReference)' == 'true'">
		<ProjectReference Include="..\Ruya.Services.MessageQueue\Ruya.Services.MessageQueue.csproj" />
	</ItemGroup>

	<ItemGroup>
		<PackageReference Include="StackExchange.Redis" />
	</ItemGroup>

</Project>
